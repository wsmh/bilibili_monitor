# ============================================
# B站评论监控器 - 环境变量配置模板
# 复制此文件为 .env 并填入你的实际配置
# ============================================

# B站UP主UID（要监控的UP主）
# 例如：1671203508（洪洪火火复盘）
UP_UID=1671203508

# 飞书机器人Webhook地址
# 从飞书群机器人设置中获取
FEISHU_WEBHOOK=https://open.feishu.cn/open-apis/bot/v2/hook/xxx

# ============================================
# B站登录态配置（重要！用于获取动态/充电专属内容评论）
# ============================================

# 方式1：直接填写完整的 Cookie 字符串（推荐）
# 从浏览器开发者工具 -> Application -> Cookies -> https://www.bilibili.com 复制
# 格式：key1=value1; key2=value2; ...
BILI_COOKIE=

# 方式2：或者单独填写以下字段（如果方式1不可用）
# 从浏览器的 Cookie 中提取对应的值
BILI_SESSDATA=
BILI_BILI_JCT=
BILI_BUVID3=
BILI_BUVID4=
BILI_DEDEUSERID=

# ============================================
# 高级配置（可选，保持默认即可）
# ============================================

# 抓取模式：browser（推荐）| api | auto
BILI_FETCH_MODE=browser

# Chrome/Chromium 浏览器路径（留空时自动探测；Windows 可填 C:\Program Files\Google\Chrome\Application\chrome.exe）
BILI_BROWSER_EXECUTABLE=

# 是否无头模式（true=不显示浏览器窗口，false=显示窗口用于调试）
BILI_BROWSER_HEADLESS=true

# 浏览器超时时间（毫秒）
BILI_BROWSER_TIMEOUT_MS=30000

# 检查间隔（秒）
CHECK_INTERVAL=10

# 触发风控后的冷却时间（秒）
SECURITY_COOLDOWN_SECONDS=120

# 高峰时段开始时间（HH:MM）
PEAK_START=09:20

# 高峰时段结束时间（HH:MM）
PEAK_END=09:40

# 高峰时段检查间隔（秒）
PEAK_INTERVAL_SECONDS=30

# 上午常规时段开始时间（HH:MM）
MORNING_START=09:40

# 上午常规时段结束时间（HH:MM）
MORNING_END=11:30

# 上午常规时段检查间隔（秒）
MORNING_INTERVAL_SECONDS=180

# 下午常规时段开始时间（HH:MM）
AFTERNOON_START=13:00

# 下午常规时段结束时间（HH:MM）
AFTERNOON_END=15:00

# 下午常规时段检查间隔（秒）
AFTERNOON_INTERVAL_SECONDS=180

# 其他时间检查间隔（秒）
DEFAULT_INTERVAL_SECONDS=1800

# 登录状态下最多获取评论页数
COMMENT_MAX_PAGES_AUTH=2

# 未登录状态下最多获取评论页数
COMMENT_MAX_PAGES_GUEST=1

# （可选）跟踪最近若干个被回复的评论线程，补齐“UP 在同一条评论下多次回复”场景
TRACKED_THREAD_SCAN_ENABLED=true
TRACKED_THREAD_MAX_ROOTS=5
TRACKED_THREAD_MAX_PAGES=3

# ============================================
# 充电问答（upower）监控配置（可选）
# 说明：充电问答是独立模块，不和充电视频绑定
# ============================================

# 是否开启充电问答监控
UPOWER_QA_ENABLED=true

# list 接口参数（保持默认即可）
UPOWER_QA_PRIVILEGE_TYPE=0
UPOWER_QA_FANS_FILTER=0
UPOWER_QA_UP_FILTER=0
UPOWER_QA_PS=20

# 本地去重缓存最近多少条问答“UP 回复”
UPOWER_QA_MAX_NOTIFIED=200

# 充电问答扫描间隔（秒）- 由于更新较慢，默认 10 分钟扫描一次即可
UPOWER_QA_SCAN_INTERVAL_SECONDS=600

# 当已配置登录态但 space feed 发生临时失败时，是否允许回退到公开视频列表
# 默认 false：避免误报“最新非充电视频”
ALLOW_PUBLIC_VIDEO_FALLBACK=false

# 首次启动行为
# warmup: 仅初始化去重，不推送历史回复（默认，避免刷屏）
# notify: 首次启动推送最近 N 条可见回复
UPOWER_QA_INIT_MODE=warmup
UPOWER_QA_INIT_NOTIFY_LIMIT=1

# 数据文件路径
DATA_FILE=notified_comments.json
